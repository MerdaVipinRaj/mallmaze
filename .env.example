# ============================================================
# MALLMAZE ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port and Node Environment
PORT=4000
NODE_ENV=production

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here
OTP_DEV_MODE=true

# Database (PostgreSQL URL or leave blank for local JSON fallback)
DATABASE_URL=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Logistics & Delivery
DELIVERY_PROVIDER=manual_ops

# ------------------------------------------------------------
# MALLMAZE PRODUCT MEDIA & AI CAMERA STUDIO CONFIGURATION
# ------------------------------------------------------------
# Provider options: local | removebg | cloudinary
IMAGE_PROCESSING_PROVIDER=local
BACKGROUND_REMOVAL_PROVIDER=local
IMAGE_ENHANCEMENT_PROVIDER=local

# Optional External AI API Keys (Leave blank to use built-in local studio fallback)
BACKGROUND_REMOVAL_API_KEY=
IMAGE_AI_API_KEY=

# Processing Limits & Timeouts
IMAGE_AI_TIMEOUT=30000
MAX_IMAGE_SIZE=10485760
MAX_IMAGES_PER_PRODUCT=9
