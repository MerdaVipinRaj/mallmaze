PORT=4000
APP_ORIGIN=http://localhost:8080
JWT_SECRET=replace-with-a-long-random-secret

# Leave empty for local JSON-file persistence.
# Set on production (Render, VPS, etc.) to store data in PostgreSQL.
DATABASE_URL=postgresql://mallmaze_user:replace-password@127.0.0.1:5432/mallmaze
# Local only. On Render, omit this — SSL is required and enabled by default.
PGSSLMODE=disable

# Development returns dev_otp in /api/auth/otp/request.
# Set false in production after wiring SMS/email provider delivery.
OTP_DEV_MODE=true

# Razorpay test/live credentials.
# Use test keys first. Keep live keys only in deployed environment variables.
# Razorpay UPI QR generation also requires QR Codes/upi_qr to be enabled on the account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Checkout economics, in paise.
PLATFORM_FEE_PAISE=2900
DELIVERY_FEE_PAISE=4900
TAX_BPS=1800

# Marketplace payout automation (Razorpay Route).
# Commission taken from each store's product subtotal before transfer (1000 = 10%).
STORE_COMMISSION_BPS=1000
# Hold store transfers for this many hours after payment (delivery/refund window).
PAYOUT_HOLD_HOURS=24

# Delivery integration placeholder: manual_ops, dunzo, shiprocket, shadowfax, porter, etc.
DELIVERY_PROVIDER=manual_ops

# =========================================================================
# Shiprocket Logistics & Courier Integration
# =========================================================================
# Set to 'false' in production when live Shiprocket API credentials are provided.
# When 'true' (or credentials left blank), MallMaze runs in Smart Sandbox mode:
# generating real-world AWBs, courier assignments (Delhivery/Shadowfax), and printable thermal labels.
SHIPROCKET_SANDBOX=true

# Dedicated API user credentials from Shiprocket Dashboard -> Settings -> API -> Configure
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Default Pickup Location registered in Shiprocket (Settings -> Pickup Address)
SHIPROCKET_PICKUP_LOCATION=Primary
